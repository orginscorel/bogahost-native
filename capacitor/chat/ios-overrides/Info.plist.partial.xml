<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bogahost Chat — iOS Info.plist parçası. Kök <dict> içine BİRLEŞTİRİLİR.
  WebRTC için kamera + mikrofon kullanım açıklamaları zorunludur.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>Görüntülü arama ve fotoğraf göndermek için kameraya erişim gerekir.</string>

    <key>NSMicrophoneUsageDescription</key>
    <string>Sesli ve görüntülü arama için mikrofona erişim gerekir.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Sohbete görsel ve dosya eklemek için fotoğraf kitaplığına erişim gerekir.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>İndirilen medyayı fotoğraf kitaplığına kaydetmek için erişim gerekir.</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>audio</string>
        <string>voip</string>
    </array>

    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
</dict>
</plist>
