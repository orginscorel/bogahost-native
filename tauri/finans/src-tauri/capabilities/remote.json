{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-notify",
  "description": "Canli finans.bogahost.com paneline yalnizca native bildirim izni (web-push yerine).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://finans.bogahost.com",
      "https://*.bogahost.com"
    ]
  },
  "permissions": [
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
