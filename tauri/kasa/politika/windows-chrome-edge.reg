Windows Registry Editor Version 5.00

; Bogahost Kasa — tarayıcı parola kasasını KAPAT (Windows).
;
; NEDEN GEREKLİ: Kasa kimlik bilgisini hedef pencereye yazar. Tarayıcı bunun
; ardından "Şifreyi kaydedeyim mi?" diye sorabilir; kabul edilirse parola
; tarayıcının kasasına ve oradan kullanıcının hesabına eşitlenir. Uygulama
; tarafından engellenemez — karar tarayıcıya aittir.
;
; Engellemenin desteklenen tek yolu politikadır. Bu anahtarlar yazıldıktan
; sonra kullanıcı tarayıcı ayarlarından GERİ AÇAMAZ.
;
; Kurulum: dosyaya sağ tık > Birleştir (yönetici gerekir), sonra tarayıcıyı
; tamamen kapatıp açın. Doğrulama: chrome://policy

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"PasswordManagerEnabled"=dword:00000000
"AutofillAddressEnabled"=dword:00000000
"AutofillCreditCardEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"PasswordManagerEnabled"=dword:00000000
"AutofillAddressEnabled"=dword:00000000
"AutofillCreditCardEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\BraveSoftware\Brave]
"PasswordManagerEnabled"=dword:00000000
