Windows Registry Editor Version 5.00

; Bogahost Kasa — Chrome yönetilen politikası (Windows).
;
; İKİ İŞ YAPAR:
;   1) Tarayıcının kendi parola kasasını kapatır ("Şifreyi kaydedeyim mi?"
;      balonu çıkmaz, kullanıcı ayarlardan geri açamaz).
;   2) Bogahost Kasa eklentisini zorunlu kurar; kullanıcı silse bile Chrome
;      update.xml'i okuyup yeniden kurar, kaldırma düğmesi pasif olur.
;
; NEDEN POLİTİKA: ikisi de tarayıcının kararıdır; masaüstü uygulaması
; dışarıdan ne parola kasasını kapatabilir ne de eklenti kurabilir.
;
; Kurulum: sağ tık > Birleştir (yönetici), sonra tarayıcıyı TAMAMEN kapatıp
; açın. Doğrulama: chrome://policy

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"PasswordManagerEnabled"=dword:00000000
"AutofillAddressEnabled"=dword:00000000
"AutofillCreditCardEnabled"=dword:00000000
; MAGAZA DISI EKLENTI ICIN DOGRU MEKANIZMA: ExtensionSettings.
; ExtensionInstallForcelist tek basina yetmiyor — chrome://policy sayfasinda
; girdi "[BLOCKED]" gorunuyor ve kurulum yapilmiyor.
"ExtensionSettings"="{\"nfoohkianbefpbobbbgfikiiicnghjeh\":{\"installation_mode\":\"force_installed\",\"update_url\":\"https://native.bogahost.com/eklenti/update.xml\",\"override_update_url\":true}}"


[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallSources]
"1"="https://native.bogahost.com/*"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"PasswordManagerEnabled"=dword:00000000
"AutofillAddressEnabled"=dword:00000000
"AutofillCreditCardEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\BraveSoftware\Brave]
"PasswordManagerEnabled"=dword:00000000
