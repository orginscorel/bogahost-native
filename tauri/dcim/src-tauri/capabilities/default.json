{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yerel pencere, tepsi, shell (harici link), native bildirim, guncelleme diyalogu ve otomatik guncelleme izinleri. 'popup-*' = indirme/onizleme pencereleri (kapatilabilir, yazdirilabilir). set-fullscreen: macOS'ta HTML tam ekran calismadigi icin PENCERE tam ekran yedegi.",
  "windows": [
    "main",
    "splash",
    "popup-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:app:default",
    "core:event:default",
    "shell:allow-open",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "dialog:default",
    "updater:default"
  ]
}
