{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-notify",
  "description": "Canli chat.bogahost.com paneline (ve onizleme pencerelerine) yalnizca native bildirim izni (web-push yerine).",
  "windows": [
    "main",
    "popup-*"
  ],
  "remote": {
    "urls": [
      "https://chat.bogahost.com",
      "https://*.bogahost.com"
    ]
  },
  "permissions": [
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission"
  ]
}
