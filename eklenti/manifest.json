{
    "manifest_version": 3,
    "name": "Bogahost Kasa",
    "version": "1.4.0",
    "key": "",
    "description": "Bogahost Bilgi Kasasi — bu bilgisayardaki Kasa uygulamasina baglanir, acilan siteye guvenli giris yapar. Tarayici bu sifreleri asla kaydetmez.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "alarms",
        "privacy"
    ],
    "host_permissions": [
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Bogahost Kasa"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "autofill.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "icons": {
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "update_url": "https://native.bogahost.com/eklenti/update.xml"
}
